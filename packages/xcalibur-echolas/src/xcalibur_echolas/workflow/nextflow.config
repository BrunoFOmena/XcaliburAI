// Pipeline parameters. Names and defaults must match the package manifest
// (manifest.yaml); tests/test_echolas_package.py checks that they do.
params {
    mode      = 'AUTO'        // trimming mode; only AUTO is implemented
    raw_data  = 'raw_data'    // directory with *.fastq.gz reads
    reference = 'reference'   // directory with exactly one .fna/.fa/.fasta genome
}

// Each process declares its own conda environment. Processes without one (plain shell
// steps) run with the host tools; `process.conda = true` used to make them ask for a
// package named "true" (issue #11).
conda {
    enabled = true
}

process {
    executor = 'local'

    cpus = 2
    memory = '1.5 GB'
    time = '12h'
}

executor {
    queueSize = 16
}

profiles {
    standard {
        process.maxForks = 8
    }

    // TEST PROFILE, not for real data: caps every process so the synthetic smoke test
    // (tests/e2e, issue #11) fits a CI runner. Results are the same; only resources change.
    test {
        conda.useMicromamba = true   // envs cached in NXF_CONDA_CACHEDIR when set
        process.resourceLimits = [cpus: 2, memory: 6.GB, time: 30.min]
        process.maxForks = 4
    }

    // DOCKER PROFILE (issue #4): every process runs in the ECHOLAS image, which holds the
    // tools at the versions locked in envs/*.linux-64.lock; conda is not used. Combine it
    // with others, e.g. `-profile test,docker`. The tag follows the package version and
    // must match `workflow.container` in manifest.yaml (tests check both).
    docker {
        conda.enabled = false
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'   // results belong to the caller
        process {
            container = 'ghcr.io/brunofomena/xcalibur-echolas:0.0.0'
            // GATK's package brings an older R into the main environment, so the PCA
            // step puts its own environment (PLINK, R 4.5 and its packages) first. It is
            // set on the container itself (a before-script hook runs outside it); the rest of the
            // value is the image's PATH (docker/Dockerfile).
            withName: 'RUN_PCA' {
                containerOptions = '--env PATH=/opt/conda/envs/echolas-pca/bin:/opt/conda/envs/echolas/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
            }
        }
    }
}