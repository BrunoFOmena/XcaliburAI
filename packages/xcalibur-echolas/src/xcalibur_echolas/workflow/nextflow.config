// Pipeline parameters. Names and defaults must match the package manifest
// (manifest.yaml); tests/test_echolas_package.py checks that they do.
params {
    mode      = 'AUTO'        // trimming mode; only AUTO is implemented
    raw_data  = 'raw_data'    // directory with *.fastq.gz reads
    reference = 'reference'   // directory with exactly one .fna/.fa/.fasta genome
}

process {
    conda = true
    executor = 'local'

    cpus = 2
    memory = '1.5 GB'
    time = '12h'
}

executor {
    queueSize = 16
}

profiles {
    standard {
        process.maxForks = 8
    }
}